# visitor-backend (Spring Boot). Spring reads these from the environment; nothing loads this file
# automatically: export them in your shell or IDE run configuration.

# dev (default) = H2 file database in visitor-backend/data/ ; prod = MySQL
SPRING_PROFILES_ACTIVE=dev

# prod profile only
DB_URL=jdbc:mysql://localhost:3306/gvdb?useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# JWT signing secret. Falls back to an insecure dev value if unset: always set it outside local dev.
JWT_SECRET=change-me
